# Reference only: container.py generates deployment.env using your private directory.
# Values here are examples; no secret values belong in this file.
EMURU_UID=1000
EMURU_GID=1000
EMURU_TELEGRAM_OWNER_ID=123456789
EMURU_PROFILE=/home/YOUR_USERNAME/.local/state/emuru/container/profiles/emuru
