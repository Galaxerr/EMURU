# Reference only: container.py init generates deployment.env once. Never source this file.
# wake/up reuse saved metadata; they do not initialize or repair private state.
# Inspect existing bind sources before init. Do not reset an existing deployment.
# Values here are examples; no secret values belong in this file.
EMURU_UID=1000
EMURU_GID=1000
EMURU_TELEGRAM_OWNER_ID=123456789
# Absolute existing Git vault with 00_Inbox; mounted at /state/vault.
EMURU_VAULT=/home/YOUR_USERNAME/private-vault
EMURU_PROFILE=/home/YOUR_USERNAME/.local/state/emuru/container/profiles/emuru
EMURU_STATE=/home/YOUR_USERNAME/.local/state/emuru/container/state
EMURU_RUNTIME=/home/YOUR_USERNAME/.local/state/emuru/container/runtime
EMURU_ROUTE=/home/YOUR_USERNAME/.local/state/emuru/container/route.json
EMURU_GATEWAY_CONFIG=/home/YOUR_USERNAME/.local/state/emuru/container/litellm.yaml
EMURU_GATEWAY_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/gateway.key
EMURU_OLLAMA_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/ollama-api.key
EMURU_GEMINI_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/gemini-api.key
EMURU_OPENAI_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/openai-api.key
EMURU_OLLAMA_STATE=/home/YOUR_USERNAME/.local/state/emuru/container/ollama
