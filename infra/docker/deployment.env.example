EMURU_RUNTIME=/home/YOUR_USERNAME/.local/state/emuru/container/runtime
EMURU_ROUTE=/home/YOUR_USERNAME/.local/state/emuru/container/route.json
EMURU_GATEWAY_CONFIG=/home/YOUR_USERNAME/.local/state/emuru/container/litellm.yaml
EMURU_GATEWAY_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/gateway.key
EMURU_OLLAMA_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/ollama-api.key
EMURU_GEMINI_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/gemini-api.key
EMURU_OPENAI_API_KEY_FILE=/home/YOUR_USERNAME/.local/state/emuru/container/openai-api.key
