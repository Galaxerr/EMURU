# Copy to .env and chmod 600. Put real credentials here; never commit .env.
OLLAMA_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
# Docker accepts GOOGLE_API_KEY as a first-init Gemini fallback.
TELEGRAM_BOT_TOKEN=
EMURU_TELEGRAM_OWNER_ID=
# Absolute path to the private Git vault mounted into the Docker agent.
EMURU_VAULT_PATH=
# container.py init generates this value only on first initialization.
# Repeated init/wake do not rotate credentials; update private copies explicitly.
EMURU_GATEWAY_KEY=
